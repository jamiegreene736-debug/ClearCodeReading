{
  "name": "clearcode-reading-frontend",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i assets/styles/clearcode-tailwind.css -o apps/core/static/css/clearcode-tailwind.css --minify",
    "check:css": "npm run build:css && git diff --exit-code -- apps/core/static/css/clearcode-tailwind.css",
    "test:responsive": "playwright test --config=playwright.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "tailwindcss": "3.4.17"
  }
}
