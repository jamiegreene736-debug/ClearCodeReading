DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.up.railway.app,healthcheck.railway.app,clearcodereading.com,www.clearcodereading.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://*.up.railway.app,https://clearcodereading.com,https://www.clearcodereading.com

POSTGRES_DB=clearcodereading
POSTGRES_USER=clearcode
POSTGRES_PASSWORD=clearcode
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=

CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Clear Code Reading <no-reply@clearcodereading.com>
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=30
PUBLIC_APP_URL=http://localhost:8000
PUBLIC_SITE_ORIGIN=https://clearcodereading.com
NOTIFICATIONS_FAIL_SILENTLY=1
# A send left in progress longer than this can be resumed safely from unsent deliveries.
NEWSLETTER_SEND_STALE_MINUTES=30
NEWSLETTER_FROM_EMAIL=ClearCode Reading <hello@clearcodereading.com>
RECRUITING_OWNER_EMAIL=
SMS_PROVIDER=stub
SCHEDULER_ADAPTER=apps.scheduling.integrations.StubSchedulerAdapter
# Acuity production adapter:
# SCHEDULER_ADAPTER=apps.scheduling.integrations.AcuitySchedulerAdapter
# Production scheduler credentials come from deployment secrets; never commit them.
ACUITY_USER_ID=
ACUITY_API_KEY=
ACUITY_APPOINTMENT_TYPE_ID=
# JSON mapping of ClearCode specialist user ID or email to Acuity calendar ID.
ACUITY_CALENDAR_IDS={}

# Workforce onboarding and payments fail closed until a provider is selected.
# The stub is for local development and contract tests only.
WORKFORCE_PROVIDER_ADAPTER=apps.workforce.integrations.StubWorkforceProviderAdapter
WORKFORCE_ALLOW_STUB_PROVIDER=1
WORKFORCE_FLORIDA_REPORTING_THRESHOLD=600.00
WORKFORCE_FEDERAL_1099_THRESHOLD_2026=2000.00
INSTRUCTIONAL_AI_SERVICE=apps.ai.services.DisabledInstructionalAIService
INSTRUCTIONAL_AI_ALLOW_NARRATIVE=0
DECISION_SUPPORT_ENGINE=apps.decision_support.engine.DeterministicDecisionSupportEngine
DECISION_SUPPORT_LEADERSHIP_ROLES=owner,admin
OUTCOMES_MIN_COHORT_SIZE=5

ELEVENLABS_API_KEY=
XI_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

USE_S3=0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# Individual CRM Google Workspace email (see docs/CRM_EMAIL.md)
CRM_EMAIL_ENABLED=0
CRM_EMAIL_GOOGLE_CLIENT_ID=
CRM_EMAIL_GOOGLE_CLIENT_SECRET=
CRM_EMAIL_REDIRECT_URI=https://clearcodereading-production.up.railway.app/crm/email/callback/
CRM_EMAIL_DOMAIN=clearcodereading.com
# Comma-separated Fernet keys. First key encrypts; remaining keys support rotation.
CRM_EMAIL_ENCRYPTION_KEYS=
CRM_EMAIL_PUBSUB_TOPIC=
CRM_EMAIL_PUBSUB_AUDIENCE=https://clearcodereading-production.up.railway.app/crm/email/push/
CRM_EMAIL_PUBSUB_EMAIL=

# Never enable on a site containing real users, contacts, or email.
ENABLE_DEMO_ACCESS=0

# Connected CRM Google mailbox that delivers website customer/team confirmations.
# Recipients see WEBSITE_EMAIL_FROM. That address must be a Gmail "Send mail as"
# alias on the WEBSITE_EMAIL_SENDER mailbox.
WEBSITE_EMAIL_SENDER=jamie@clearcodereading.com
WEBSITE_EMAIL_FROM=hello@clearcodereading.com
WEBSITE_EMAIL_FROM_NAME=ClearCode Reading
